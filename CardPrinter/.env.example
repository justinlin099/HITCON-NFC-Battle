# Trusted fallback used only when the App remote config cannot be downloaded.
# Do not add /staff/print-cards here.
API_BASE_URL=https://nfc-battle-api.hitcon2026.online

# Same public runtime configuration used by the Flutter App. CardPrinter reads
# it once at startup before creating any client that can carry a STAFF JWT.
REMOTE_CONFIG_URL=https://game.hitcon2026.online/.well-known/nfc-battle-app-config.json

# Optional. If blank, the local web page asks for a STAFF JWT and keeps it only
# in the current page memory. Never commit a real token.
STAFF_JWT=

# Local Windows port. Keep the loopback binding in compose.yaml so camera access
# works at http://localhost without exposing the workstation service to the LAN.
CARDPRINTER_PORT=18080

# USB/ADB phone-scanner relay. This is a separate, capability-limited service;
# keep its Windows port bound to loopback in compose.yaml.
CARDPRINTER_COMPANION_PORT=18081

# Advanced development overrides. Production should keep these blank/false.
CARDPRINTER_ALLOWED_API_HOSTS=
CARDPRINTER_ALLOW_HTTP_API=false
# Optional extra browser Host names for a trusted HTTPS reverse proxy.
CARDPRINTER_ALLOWED_WEB_HOSTS=
CARDPRINTER_MAX_PNG_BYTES=10485760

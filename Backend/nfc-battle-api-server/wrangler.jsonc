/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nfc-battle-api-server",
	"main": "src/worker.ts",
	"compatibility_date": "2026-06-07",
	"migrations": [
		{
			"tag": "v1_scoreboard_coordinator",
			"new_sqlite_classes": ["ScoreboardCoordinator"]
		}
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": false,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": false
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "nfc-battle-api-server",
			"database_id": "00000000-0000-0000-0000-000000000000"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SCOREBOARD_COORDINATOR",
				"class_name": "ScoreboardCoordinator"
			}
		]
	},
	"r2_buckets": [
		{
			"binding": "PRINT_CARD_IMAGES",
			"bucket_name": "nfc-battle-print-cards"
		}
	],
	"ratelimits": [
		{
			"name": "PRINT_CARD_USER_RATE_LIMITER",
			"namespace_id": "2026082101",
			"simple": { "limit": 5, "period": 60 }
		},
		{
			"name": "PRINT_CARD_GLOBAL_RATE_LIMITER",
			"namespace_id": "2026082102",
			"simple": { "limit": 300, "period": 60 }
		},
		{
			"name": "AUTH_HEALTH_RATE_LIMITER",
			"namespace_id": "2026082131",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "MY_PROFILE_READ_RATE_LIMITER",
			"namespace_id": "2026082132",
			"simple": { "limit": 20, "period": 60 }
		},
		{
			"name": "MY_PROFILE_UPDATE_RATE_LIMITER",
			"namespace_id": "2026082133",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "MY_PRIZE_READ_RATE_LIMITER",
			"namespace_id": "2026082134",
			"simple": { "limit": 20, "period": 60 }
		},
		{
			"name": "MY_BOOTSTRAP_RATE_LIMITER",
			"namespace_id": "2026082135",
			"simple": { "limit": 3, "period": 60 }
		},
		{
			"name": "USER_BATCH_READ_RATE_LIMITER",
			"namespace_id": "2026082136",
			"simple": { "limit": 20, "period": 60 }
		},
		{
			"name": "USER_PROFILE_READ_RATE_LIMITER",
			"namespace_id": "2026082137",
			"simple": { "limit": 30, "period": 60 }
		},
		{
			"name": "USER_COLLECTION_READ_RATE_LIMITER",
			"namespace_id": "2026082138",
			"simple": { "limit": 5, "period": 60 }
		},
		{
			"name": "TAG_PAIR_RATE_LIMITER",
			"namespace_id": "2026082139",
			"simple": { "limit": 5, "period": 60 }
		},
		{
			"name": "COLLECTION_SCAN_RATE_LIMITER",
			"namespace_id": "2026082140",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "PHISHING_RECORD_RATE_LIMITER",
			"namespace_id": "2026082141",
			"simple": { "limit": 3, "period": 60 }
		},
		{
			"name": "STAMP_MISSION_READ_RATE_LIMITER",
			"namespace_id": "2026082142",
			"simple": { "limit": 60, "period": 60 }
		},
		{
			"name": "SCOREBOARD_READ_RATE_LIMITER",
			"namespace_id": "2026082143",
			"simple": { "limit": 60, "period": 60 }
		},
		{
			"name": "MY_SCOREBOARD_READ_RATE_LIMITER",
			"namespace_id": "2026082144",
			"simple": { "limit": 60, "period": 60 }
		}
	],
	"vars": {
		"JWT_ISSUER": "hitcon-2026",
		"JWT_AUDIENCE": "nfc-battle-api-server",
		"PRINT_CARD_MAX_UPLOAD_BYTES": "4194304",
		"SCOREBOARD_REFRESH_SECONDS": "10"
